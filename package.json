{
  "name": "deepseek-harness-gui",
  "version": "0.1.0",
  "description": "Open the dsh Web GUI in a Glimpse native window.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "cordis.patch.yml"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/hazat/glimpse" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@deepseek-ai/dsh-cmdline": "*",
    "commander": "^15.0.0",
    "glimpseui": "^0.8.1"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "*" },
  "devDependencies": { "@deepseek-ai/cordis": "*", "@types/node": "^22.0.0", "typescript": "^6.0.0" }
}
